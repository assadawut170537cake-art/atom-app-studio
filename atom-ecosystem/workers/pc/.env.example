# ATOM Core (VPS) base URL — ผ่าน Cloudflare Tunnel
ATOM_BASE_URL=https://assadawut-jarvis.online

# ตองตรงกับ ATOM_SECRET บน VPS (/opt/atom-core/.env)
ATOM_SECRET=change_this_secret

# ตัวตนของ node นี้
WORKER_ID=PC_WORKSTATION
TASK_TYPE=ULTRON_CODE

# รอบวืนจนาที (วินาที)
HEARTBEAT_INTERVAL=20
POLL_INTERVAL=10
HTTP_TIMEOUT=10

# 0 = รันตลอดไป | >0 = หยุดหลังครบ N รอบ (ใช้สำหรับทดสอบ)
ULTRON_MAX_CYCLES=0
ULTRON_LOG=ultron_daemon.log
